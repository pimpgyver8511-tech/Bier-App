# Datenbank (Postgres, z.B. Vercel Postgres/Neon, Prisma Postgres, lokal via Docker...)
DATABASE_URL="postgresql://user:password@localhost:5432/bierapp?schema=public"

# Admin-Zugang zur Bier App (Admin-Bereich /admin)
ADMIN_PASSWORD="change-me"

# Geheimer Schluessel zum Signieren der Admin-Session (beliebiger langer Zufallsstring)
SESSION_SECRET="change-me-too-please-use-a-long-random-string"

# Die Spielerplus-Kalender-URL (.ics) fuer den Spielplan-Sync wird nicht hier,
# sondern direkt im Admin-Bereich unter Einstellungen gepflegt.
