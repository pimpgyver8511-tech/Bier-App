# Datenbank (SQLite-Datei, lokal)
DATABASE_URL="file:./prisma/dev.db"

# Admin-Zugang zur Bier App (Admin-Bereich /admin)
ADMIN_PASSWORD="change-me"

# Geheimer Schluessel zum Signieren der Admin-Session (beliebiger langer Zufallsstring)
SESSION_SECRET="change-me-too-please-use-a-long-random-string"

# Optional: Spielerplus-Zugangsdaten fuer den automatischen Anwesenheits-Sync.
# Ohne diese Werte funktioniert die App normal, nur der Sync-Button im Admin-Bereich
# ist deaktiviert und Anwesenheiten muessen manuell gepflegt werden.
SPIELERPLUS_EMAIL=""
SPIELERPLUS_PASSWORD=""
# Team-/Kader-URL bei Spielerplus, z.B. https://www.spielerplus.de/team/12345/matches
SPIELERPLUS_TEAM_URL=""
