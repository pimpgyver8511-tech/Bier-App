// Bier App – Datenmodell

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  alias     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  attendances Attendance[]
  assignments KastenAssignment[]
  importRows  KastenImportRow[]
  eventParticipations EventParticipant[]
}

model Match {
  id              String    @id @default(cuid())
  externalId      String?   @unique
  // SPIEL (Default) oder TRAINING - siehe syncMatchScheduleFromIcs()
  // (UID-Praefix "training." im Spielerplus-.ics-Kalender). Gegner/
  // Heim-Auswaerts sind nur bei SPIEL relevant; Anwesenheit und
  // Kasten-Zuteilung funktionieren fuer beide Arten identisch.
  type            MatchType @default(SPIEL)
  date            DateTime
  // Wird beim manuellen Bearbeiten der Spielzeit gesetzt (siehe
  // editMatchAction) - schuetzt eine bewusst korrigierte Zeit davor, vom
  // naechsten Spielerplus-ICS-Sync wieder ueberschrieben zu werden (siehe
  // syncMatchScheduleFromIcs).
  dateManuallySet Boolean   @default(false)
  opponent        String?
  location        String?
  isHome          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())

  attendances Attendance[]
  assignments KastenAssignment[]
}

enum MatchType {
  SPIEL
  TRAINING
}

enum AttendanceStatus {
  ZUSAGE
  ABSAGE
  UNSICHER
  UNKNOWN
}

enum AttendanceSource {
  MANUAL
  SPIELERPLUS
}

model Attendance {
  id        String            @id @default(cuid())
  matchId   String
  playerId  String
  status    AttendanceStatus  @default(UNKNOWN)
  source    AttendanceSource  @default(MANUAL)
  updatedAt DateTime          @updatedAt

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

// Sonstige Mannschafts-Termine aus Spielerplus (UID-Praefix "event.", z.B.
// "Weihnachtsfeier") - bewusst getrennt von Match, damit sie weder in der
// Kasten-Zuteilung noch in Spiel-/Trainingsuebersichten auftauchen.
model TeamEvent {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  title       String
  date        DateTime
  location    String?
  // Vom Admin gepflegt: Restaurant/Lokal und ein kurzer Einladungstext
  restaurant  String?
  invitation  String?
  // Essensbestellung (z.B. Weihnachtsfeier im Restaurant)
  mealOrder   Boolean  @default(false)
  menuUrl     String?
  // Bestellung abgeschlossen: Spieler koennen ihre Wahl nicht mehr aendern
  orderLocked Boolean  @default(false)
  createdAt   DateTime @default(now())

  participants EventParticipant[]
}

// Teilnehmer eines TeamEvent. playerId fehlt bei Namen aus dem Spielerplus-
// Export, die keinem Spieler zugeordnet werden konnten, und bei Gaesten.
model EventParticipant {
  id        String           @id @default(cuid())
  eventId   String
  playerId  String?
  name      String
  source    AttendanceSource @default(MANUAL)
  dish      String?
  dishPrice Float?
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event  TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([eventId, name])
}

model KastenAssignment {
  id          String   @id @default(cuid())
  matchId     String?
  playerId    String
  reason      String?
  fulfilled   Boolean  @default(false)
  fulfilledAt DateTime?
  createdAt   DateTime @default(now())

  match  Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

enum ImportSource {
  SEITE3
  OFFEN
  GUTHABEN
}

// Zwischenspeicher fuer den Import der alten, handisch gepflegten
// Kasten-Historie (siehe docs/kasten-historie-import.md). Wird ueber
// Admin > Import befuellt, Zeile fuer Zeile geprueft/korrigiert und dann
// in echte Match+KastenAssignment-Eintraege umgewandelt.
model KastenImportRow {
  id           String       @id @default(cuid())
  source       ImportSource
  rawDate      String?
  resolvedDate DateTime?
  nickname     String
  reason       String?
  count        Int          @default(1)
  suggestedPlayerId String?
  playerId     String?
  createdAt    DateTime     @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

model Settings {
  id                Int @id @default(1)
  cooldownWeeks     Int @default(6)
  kastenPerMatch    Int @default(2)
  kastenPerTraining Int @default(1)
}

model SpielerplusConfig {
  id          Int      @id @default(1)
  icsUrl      String?
  lastSyncAt  DateTime?
  lastSyncOk  Boolean  @default(false)
  lastSyncMsg String?
}

// Taeglich per Cron befuellte Bierkasten-Angebote (siehe
// src/lib/beerdeals.ts). Wird bei jedem Sync komplett geleert und neu
// befuellt - es gibt bewusst keine Historie, nur die aktuell gueltigen
// Angebote. validFrom/validUntil filtern Tagesangebote, die nur an
// einzelnen Tagen gelten (siehe getAllBeerDeals).
model BeerDeal {
  id         String    @id @default(cuid())
  brand      String
  store      String?
  price      Float?
  sourceUrl  String
  offerUrl   String?
  validFrom  DateTime?
  validUntil DateTime?
  fetchedAt  DateTime  @default(now())
}

model BeerDealsConfig {
  id          Int       @id @default(1)
  lastSyncAt  DateTime?
  lastSyncOk  Boolean   @default(false)
  lastSyncMsg String?
}

// Sekt-/Prosecco-Angebote fuer eine nicht verlinkte Spass-Seite (siehe
// src/lib/sparklingdeals.ts) - bewusst eine eigene Tabelle, damit die
// Bierangebote der Mannschaft davon komplett unberuehrt bleiben. Gleiches
// Prinzip wie BeerDeal: bei jedem Sync komplett geleert und neu befuellt.
model SparklingDeal {
  id         String    @id @default(cuid())
  title      String
  details    String?
  store      String
  price      Float
  sourceUrl  String
  offerUrl   String?
  validFrom  DateTime?
  validUntil DateTime?
  // Nur in einzelnen Filialen erhaeltlich: Filialnamen, mit "|" getrennt
  // (z.B. "Kaufland Leipzig-Paunsdorf"); leer = ueberall beim Haendler
  onlyAt     String?
  fetchedAt  DateTime  @default(now())
}

model SparklingDealsConfig {
  id          Int       @id @default(1)
  lastSyncAt  DateTime?
  lastSyncOk  Boolean   @default(false)
  lastSyncMsg String?
  // JSON (SparklingSyncDebug): aussortierte Angebote usw. fuer die Admin-Diagnose
  lastSyncDebug String?
}
