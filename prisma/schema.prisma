// Bier App – Datenmodell

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  alias     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  attendances Attendance[]
  assignments KastenAssignment[]
  importRows  KastenImportRow[]
}

model Match {
  id              String   @id @default(cuid())
  externalId      String?  @unique
  date            DateTime
  // Wird beim manuellen Bearbeiten der Spielzeit gesetzt (siehe
  // editMatchAction) - der Spielerplus-ICS-Sync setzt fuer jedes Spiel
  // pauschal 19 Uhr an (die tatsaechliche Anstosszeit steht dort nicht
  // zuverlaessig), ueberschreibt eine so manuell korrigierte Zeit aber
  // nicht erneut (siehe syncMatchScheduleFromIcs).
  dateManuallySet Boolean  @default(false)
  opponent        String?
  location        String?
  isHome          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  attendances Attendance[]
  assignments KastenAssignment[]
}

enum AttendanceStatus {
  ZUSAGE
  ABSAGE
  UNSICHER
  UNKNOWN
}

enum AttendanceSource {
  MANUAL
  SPIELERPLUS
}

model Attendance {
  id        String            @id @default(cuid())
  matchId   String
  playerId  String
  status    AttendanceStatus  @default(UNKNOWN)
  source    AttendanceSource  @default(MANUAL)
  updatedAt DateTime          @updatedAt

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model KastenAssignment {
  id          String   @id @default(cuid())
  matchId     String?
  playerId    String
  reason      String?
  fulfilled   Boolean  @default(false)
  fulfilledAt DateTime?
  createdAt   DateTime @default(now())

  match  Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

enum ImportSource {
  SEITE3
  OFFEN
  GUTHABEN
}

// Zwischenspeicher fuer den Import der alten, handisch gepflegten
// Kasten-Historie (siehe docs/kasten-historie-import.md). Wird ueber
// Admin > Import befuellt, Zeile fuer Zeile geprueft/korrigiert und dann
// in echte Match+KastenAssignment-Eintraege umgewandelt.
model KastenImportRow {
  id           String       @id @default(cuid())
  source       ImportSource
  rawDate      String?
  resolvedDate DateTime?
  nickname     String
  reason       String?
  count        Int          @default(1)
  suggestedPlayerId String?
  playerId     String?
  createdAt    DateTime     @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

model Settings {
  id             Int    @id @default(1)
  cooldownWeeks  Int    @default(6)
  kastenPerMatch Int    @default(2)
}

model SpielerplusConfig {
  id          Int      @id @default(1)
  icsUrl      String?
  lastSyncAt  DateTime?
  lastSyncOk  Boolean  @default(false)
  lastSyncMsg String?
}

// Taeglich per Cron befuellte Bierkasten-Angebote (siehe
// src/lib/beerdeals.ts). Wird bei jedem Sync komplett geleert und neu
// befuellt - es gibt bewusst keine Historie, nur die aktuell gueltigen
// Angebote. validFrom/validUntil filtern Tagesangebote, die nur an
// einzelnen Tagen gelten (siehe getAllBeerDeals).
model BeerDeal {
  id         String    @id @default(cuid())
  brand      String
  store      String?
  price      Float?
  sourceUrl  String
  offerUrl   String?
  validFrom  DateTime?
  validUntil DateTime?
  fetchedAt  DateTime  @default(now())
}

model BeerDealsConfig {
  id          Int       @id @default(1)
  lastSyncAt  DateTime?
  lastSyncOk  Boolean   @default(false)
  lastSyncMsg String?
}
